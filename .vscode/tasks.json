{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build (debug)",
      "type": "shell",
      "command": "swift build",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$swiftc"]
    },
    {
      "label": "Build Notepad.app",
      "type": "shell",
      "command": "./build.sh",
      "group": "build",
      "problemMatcher": ["$swiftc"]
    },
    {
      "label": "Build & Run Notepad.app",
      "type": "shell",
      "command": "./build.sh && open Notepad.app",
      "group": "build",
      "problemMatcher": ["$swiftc"]
    },
    {
      "label": "Build & Install to /Applications",
      "type": "shell",
      "command": "./build.sh --install",
      "group": "build",
      "problemMatcher": ["$swiftc"]
    }
  ]
}
