{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Notepad",
      "type": "swift",
      "request": "launch",
      "target": "Notepad",
      "configuration": "debug",
      "args": [],
      "cwd": "${workspaceFolder:notepad}",
      "preLaunchTask": "swift: Build Debug Notepad"
    },
    {
      "name": "Debug Notepad (open current file)",
      "type": "swift",
      "request": "launch",
      "target": "Notepad",
      "configuration": "debug",
      "args": [],
      "cwd": "${workspaceFolder:notepad}",
      "env": { "NOTEPAD_OPEN": "${file}" },
      "preLaunchTask": "swift: Build Debug Notepad"
    },
    {
      "name": "Release Notepad",
      "type": "swift",
      "request": "launch",
      "target": "Notepad",
      "configuration": "release",
      "args": [],
      "cwd": "${workspaceFolder:notepad}",
      "preLaunchTask": "swift: Build Release Notepad"
    }
  ]
}
